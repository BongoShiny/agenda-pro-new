{
  "name": "InteracaoLead",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "ID do lead"
    },
    "lead_nome": {
      "type": "string",
      "description": "Nome do lead"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "tentativa_contato",
        "contato_realizado",
        "reuniao_agendada",
        "reuniao_realizada",
        "proposta_enviada",
        "negociacao",
        "visita_clinica",
        "conversao_fechamento",
        "conversao_perda",
        "cancelamento",
        "anotacao"
      ],
      "description": "Tipo da intera\u00e7\u00e3o"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada da intera\u00e7\u00e3o"
    },
    "resultado": {
      "type": "string",
      "enum": [
        "positivo",
        "negativo",
        "neutro"
      ],
      "description": "Resultado da intera\u00e7\u00e3o"
    },
    "vendedor_nome": {
      "type": "string",
      "description": "Nome do vendedor que fez a intera\u00e7\u00e3o"
    },
    "data_interacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da intera\u00e7\u00e3o"
    },
    "proxima_acao": {
      "type": "string",
      "description": "Pr\u00f3xima a\u00e7\u00e3o a ser tomada"
    },
    "data_proxima_acao": {
      "type": "string",
      "format": "date",
      "description": "Data da pr\u00f3xima a\u00e7\u00e3o"
    }
  },
  "required": [
    "lead_id",
    "lead_nome",
    "tipo",
    "descricao"
  ]
}