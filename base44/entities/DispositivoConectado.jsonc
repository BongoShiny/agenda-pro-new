{
  "name": "DispositivoConectado",
  "type": "object",
  "properties": {
    "usuario_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "dispositivo": {
      "type": "string",
      "description": "Informa\u00e7\u00f5es do dispositivo/navegador"
    },
    "ip": {
      "type": "string",
      "description": "Endere\u00e7o IP"
    },
    "localizacao": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o aproximada (cidade/pa\u00eds)"
    },
    "data_login": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora do login"
    },
    "sessao_ativa": {
      "type": "boolean",
      "description": "Se a sess\u00e3o ainda est\u00e1 ativa",
      "default": true
    }
  },
  "required": [
    "usuario_email",
    "dispositivo"
  ]
}