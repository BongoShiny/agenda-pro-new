{
  "name": "SessaoAtiva",
  "type": "object",
  "properties": {
    "usuario_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "sessao_id": {
      "type": "string",
      "description": "ID \u00fanico da sess\u00e3o"
    },
    "dispositivo": {
      "type": "string",
      "description": "Informa\u00e7\u00f5es do dispositivo/navegador"
    },
    "ip": {
      "type": "string",
      "description": "Endere\u00e7o IP"
    },
    "ultima_atividade": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima vez que o usu\u00e1rio foi visto ativo"
    }
  },
  "required": [
    "usuario_email",
    "sessao_id"
  ]
}